rules_version = '2';

// Storage security rules — source of truth for uet-app-281cf.
//
// Deploy from this repo:
//   firebase deploy --only storage
//
// Do NOT add a broad match /{allPaths=**} allow that overlaps SWMS —
// Storage grants access if ANY matching rule allows it.
//
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // SWMS PDFs — uploaded via Cloud Functions (Admin SDK).
    // Clients open files via tokenized download URLs returned by the backend.
    match /safety/swms/{docId}/{fileName} {
      allow read, write: if false;
    }

    // Other app storage paths (RCD images, etc.) — signed-in only.
    match /rcd_test_jobs/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /sites/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Job Folder Creation — client uploads temp files, then Cloud Functions
    // move them into Simpro. Downloads are written by Admin SDK.
    match /simpro_folder_creation/temp/{userId}/{fileName} {
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 80 * 1024 * 1024;
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /simpro_folder_creation/downloads/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
